let square = |x: number| -> number { x * x };
let cube = |x: number| x * x * x;
let add = |a, b| a + b;
let make_point = |x: number, y: number| { x: x, y: y };   // table, not block
let block_body = |x: number| { let y = x + 1; y * 2 };    // block

fn apply(f: fn(number) -> number, v: number) -> number {
    f(v)
}

let doubled = apply(|x: number| x * 2, 21);

fn counter() -> fn() -> number {
    let mut count = 0;
    || { count += 1; count }       // captures by reference (Luau semantics)
}

let who = "world";
let greeting = `hello {who}, 1 + 2 = {1 + 2}`;
let nested = `a {`b {who}`} c`;